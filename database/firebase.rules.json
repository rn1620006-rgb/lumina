{
  "rules": {
    ".read": false,
    ".write": false,
    "lumina_v1": {
      "public": {
        "registrationEnabled": {
          ".read": true,
          ".write": false
        }
      },
      "profiles": {
        "$uid": {
          ".read": "auth !== null && auth.uid === $uid",
          ".write": "auth !== null && auth.uid === $uid && newData.exists() && (!data.exists() || newData.child('role').val() === data.child('role').val())",
          ".validate": "newData.hasChildren(['uid','name','email','role','city','createdAt'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120"
          },
          "email": {
            ".validate": "newData.isString() && newData.val() === auth.token.email"
          },
          "role": {
            ".validate": "newData.isString() && (newData.val() === 'cliente' || newData.val() === 'profissional') && (!data.exists() || data.val() === newData.val())"
          },
          "city": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || data.val() === newData.val())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "requests": {
        "$uid": {
          ".read": "auth !== null && auth.uid === $uid",
          "$requestId": {
            ".write": "auth !== null && auth.uid === $uid && auth.token.email_verified === true && root.child('lumina_v1/profiles').child($uid).child('role').val() === 'cliente' && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['id','ownerUid','title','category','city','details','createdAt','status']) && newData.childrenCount() === 8",
            "id": {
              ".validate": "newData.isString() && newData.val() === $requestId"
            },
            "ownerUid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 120"
            },
            "category": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
            },
            "city": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
            },
            "details": {
              ".validate": "newData.isString() && newData.val().length >= 12 && newData.val().length <= 900"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() >= now-300000 && newData.val() <= now+60000"
            },
            "status": {
              ".validate": "newData.isString() && newData.val() === 'novo'"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
